{
  "version": 1,
  "storage": {
    "type": "h2",
    "host": "127.0.0.1",
    "port": 3306,
    "username": "root",
    "password": "passw0rd",
    "database": "neobot",
    "options": [
      "useUnicode=true",
      "characterEncoding=utf-8"
    ],
    "pool-settings": {
      "maximum-pool-size": 50,
      "minimum-idle": 10,
      "maximum-lifetime": 1800000,
      "keepalive-time": 0,
      "connection-timeout": 5000
    }
  },
  "bot": {
    "type": [
      "onebot11-ws"
    ],
    "onebot11-ws": {
      "url": "ws://127.0.0.1:3001",
      "access-token": ""
    },
    "onebot11-ws-reverse": {
      "address": "127.0.0.1",
      "port": "8080",
      "access-token": ""
    },
    "qq": {
      "server-status": {
        "enabled": true
      },
      "player-status": {
        "enabled": true
      },
      "management": {
        "owner-user-ids": [],
        "admin-user-ids": []
      }
    },
    "player-status": {
      "join-message": "[${server}] ${player} 进入了服务器!",
      "quit-message": "[${server}] ${player} 离开了服务器!",
      "death-message": "[${server}] ${player} 逝世了!"
    },
    "account": {
      "require-binding": true,
      "require-binding-message": "请绑定 QQ 或 Discord 账号后再进入服务器。"
    },
    "discord": {
      "enabled": false,
      "token": "",
      "intents": 37377,
      "proxy": {
        "mode": "official",
        "url": ""
      },
      "channels": {
        "chat-channel-id": "",
        "bind-channel-id": "",
        "server-messages-channel-id": ""
      },
      "server-status": {
        "enabled": true,
        "server-name": "Minecraft",
        "start-message": "[${server}] 服务器已启动!",
        "stop-message": "[${server}] 服务器已关闭!"
      },
      "player-status": {
        "enabled": true
      },
      "chat": {
        "maximum-length": 1900,
        "ignore-self": true,
        "ignore-bots": true,
        "minecraft-to-discord": {
          "enabled": true,
          "format": "[MC] ${player}: ${message}"
        },
        "discord-to-minecraft": {
          "enabled": true,
          "format": "§d[Discord(${channel})]§r §b${user}§r: ${message}"
        }
      },
      "account": {
        "maximum-bindings-per-user": 1
      },
      "management": {
        "owner-user-ids": [],
        "admin-user-ids": [],
        "default-server": "login",
        "servers": [
          {"server-name": "login", "prefix": "login", "executor": "bukkit", "enabled": true}
        ],
        "remote-command-result-format": "[NeoBot] 命令执行结果: \n${result}"
      }
    },
    "options": {
      "check-interval": 30,
      "enable-groups": [
        114514
      ]
    }
  },
  "repository": {
    "use-github-proxy": false,
    "github-proxy-url": "",
    "auto-update": {
      "enabled": false,
      "check-interval-minutes": 60,
      "connect-timeout-ms": 3000,
      "mirrors": []
    }
  },
  "chat-forward": {
    "to-qq": {
      "enable": true,
      "format": "[MC] ${player}: ${message}",
      "max-length": 1900
    },
    "to-game": {
      "enable": true,
      "format": "§c[QQ群(${group})]§r §b${user}§r: ${message}",
      "max-length": 1900
    }
  },
  "js": {
    "all-access": false
  }
}
